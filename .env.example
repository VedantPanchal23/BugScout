# BugScout Environment Configuration (Zero-Cost LLM Providers)
# Leave blank to use the built-in offline security heuristic & rule engine (100% Free, Zero Setup)

# 1. Groq Free API (Ultra-fast Llama 3 / Mixtral inference - Free at https://console.groq.com)
GROQ_API_KEY=

# 2. Google Gemini Free Tier (Free at https://aistudio.google.com)
GEMINI_API_KEY=

# 3. Hugging Face Free Inference API (Free at https://huggingface.co/settings/tokens)
HF_TOKEN=

# 4. Local Ollama (e.g. http://localhost:11434)
OLLAMA_HOST=
